# GitHub Personal Access Token (required for API calls)
# Create one at: https://github.com/settings/tokens
# Required scopes: public_repo (for public repos) or repo (for private repos)
GITHUB_TOKEN=your_github_token_here

# Optional: Multiple tokens for rate limit rotation
# PAT_1=your_token_here
# PAT_2=your_token_here

# Server port
PORT=3000
